[Unit]
Description=Read-only Pueblo paired weekly observations for PLAZA prediction research
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/pr-shopper-pipeline
ExecStart=%h/pr-shopper-pipeline/.venv/bin/python %h/pr-shopper-pipeline/spikes/001-pueblo-catalog/research.py
ExecStartPost=%h/pr-shopper-pipeline/.venv/bin/python %h/pr-shopper-pipeline/spikes/001-pueblo-catalog/evaluate.py
TimeoutStartSec=3h
NoNewPrivileges=true
