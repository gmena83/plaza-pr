[Unit]
Description=PR Shopper Prices API
After=network.target

[Service]
WorkingDirectory=%h/pr-shopper-pipeline
Environment=PYTHONPATH=%h/pr-shopper-pipeline
ExecStart=%h/pr-shopper-pipeline/.venv/bin/uvicorn api.main:app --host 127.0.0.1 --port 8200
Restart=on-failure

[Install]
WantedBy=default.target
