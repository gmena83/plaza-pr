<!DOCTYPE html>
<html lang="es" xmlns="http://www.w3.org/1999/xhtml">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="color-scheme" content="dark">
<meta name="supported-color-schemes" content="dark">
<title>{{ subject }}</title>
<style>
  body{margin:0;padding:0;background:#0b0e11}
  a{color:#ffd400}
  @media (max-width:620px){
    .outer{padding:0 !important}
    .shell{border-left:0 !important;border-right:0 !important}
    .px{padding-left:14px !important;padding-right:14px !important}
    .hl{font-size:19px !important}
    .pr{font-size:15px !important}
    .cta{width:100% !important}
    .cta a{display:block !important;text-align:center !important}
  }
</style>
</head>
<body style="margin:0;padding:0;background:#0b0e11;">
{# inbox preview line, then whitespace so the client doesn't pull body text after it #}
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#0b0e11;font-size:1px;line-height:1px;">{{ preheader }}&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#0b0e11" style="background:#0b0e11;">
<tr><td class="outer" align="center" style="padding:24px 8px;">
<table class="shell" role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" bgcolor="#11161b"
       style="width:100%;max-width:600px;background:#11161b;border:1px solid #232d36;font-family:{{ mono }};">

  {# masthead #}
  <tr><td class="px" style="padding:20px 24px 14px 24px;border-bottom:1px solid #232d36;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
      <td style="font-family:{{ mono }};font-size:24px;font-weight:800;letter-spacing:-1px;color:#e8eef2;">PLA<span style="color:#ffd400;">ZA</span></td>
      <td align="right" style="font-family:{{ mono }};font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#8fa1ad;">Mi Lista &middot; {{ date_label }}</td>
    </tr></table>
  </td></tr>

  {# verdict #}
  <tr><td class="px" style="padding:24px 24px 6px 24px;">
    <div style="font-family:{{ mono }};font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:#2fd6a3;font-weight:700;">{{ eyebrow }}</div>
    <div class="hl" style="font-family:{{ mono }};font-size:21px;line-height:1.3;font-weight:800;color:#e8eef2;padding-top:8px;">{{ headline }}</div>
    <div style="font-family:{{ mono }};font-size:13px;line-height:1.5;font-weight:700;color:#ffd400;padding-top:8px;">{{ total_line }}</div>
    {% if n_ending %}
    <div style="font-family:{{ mono }};font-size:12px;color:#ff5a3c;padding-top:6px;">&#9679; {{ n_ending }} oferta{{ 's' if n_ending > 1 }} termina{{ 'n' if n_ending > 1 }} en los próximos 2 días</div>
    {% endif %}
  </td></tr>

  {# one block per store #}
  {% for s in stores %}
  <tr><td class="px" style="padding:18px 24px 0 24px;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #232d36;">
      <tr>
        <td bgcolor="#161d24" style="background:#161d24;border-left:3px solid {{ s.color }};padding:10px 12px;font-family:{{ mono }};">
          <span style="font-size:12px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:{{ s.color }};">{% if stores|length > 1 %}{{ loop.index }} &middot; {% endif %}{{ s.short }}</span>
          <span style="font-size:11px;color:#8fa1ad;">&nbsp;{{ s.rows|length }}&nbsp;producto{{ 's' if s.rows|length != 1 }}</span>
        </td>
        <td bgcolor="#161d24" align="right" style="background:#161d24;padding:10px 12px;font-family:{{ mono }};font-size:13px;font-weight:800;color:#ffd400;white-space:nowrap;">${{ '%.2f'|format(s.subtotal) }}</td>
      </tr>
      {% for r in s.rows %}
      {% set last = loop.last %}
      {% set show_chain = false %}
      {% include "_row.html.j2" %}
      {% endfor %}
    </table>
  </td></tr>
  {% endfor %}

  {% if elsewhere %}
  <tr><td class="px" style="padding:22px 24px 0 24px;">
    <div style="font-family:{{ mono }};font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#5a6b76;font-weight:700;padding-bottom:8px;">También en oferta, en otra tienda</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #232d36;">
      {% for r in elsewhere %}
      {% set last = loop.last %}
      {% set show_chain = true %}
      {% include "_row.html.j2" %}
      {% endfor %}
    </table>
  </td></tr>
  {% endif %}

  {% if unavailable %}
  <tr><td class="px" style="padding:18px 24px 0 24px;font-family:{{ mono }};font-size:12px;line-height:1.6;color:#8fa1ad;">
    <span style="font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:#5a6b76;font-weight:700;">Sin oferta esta semana</span><br>
    {{ unavailable|join(' · ') }}
  </td></tr>
  {% endif %}

  {# CTA #}
  <tr><td class="px" style="padding:26px 24px 26px 24px;">
    <table class="cta" role="presentation" cellpadding="0" cellspacing="0" border="0"><tr>
      <td bgcolor="#ffd400" style="background:#ffd400;">
        <a href="{{ site_url }}" style="display:inline-block;padding:14px 22px;font-family:{{ mono }};font-size:13px;font-weight:800;letter-spacing:.06em;color:#000000;text-decoration:none;">ABRIR MI LISTA &rarr;</a>
      </td>
    </tr></table>
  </td></tr>

  {# footer #}
  <tr><td class="px" style="padding:16px 24px 22px 24px;border-top:1px solid #232d36;font-family:{{ mono }};font-size:12px;line-height:1.65;color:#8fa1ad;">
    Recibes este resumen porque guardaste productos en Mi Lista de PLAZA. Llega lunes y jueves.
    Precios tomados de los shoppers públicos de cada cadena; pueden variar en tienda.
    {% if can_reply %}¿Dudas o sugerencias? Responde a este email.{% endif %}<br>
    <a href="{{ unsubscribe_url }}" style="color:#e8eef2;text-decoration:underline;">Dejar de recibir estos emails</a>
    {% if feedback_url %}&nbsp;&middot;&nbsp;<a href="{{ feedback_url }}" style="color:#e8eef2;text-decoration:underline;">Enviar comentarios</a>{% endif %}
    {% if postal_address %}<br>PLAZA &middot; {{ postal_address }}{% endif %}
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
